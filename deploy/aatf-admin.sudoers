# Privileges for the admin panel service user.
#
# Exactly one command, enumerated per action. No wildcards on the action: a rule
# like `systemctl start aatf-*` would let the caller start any unit whose name
# they can arrange to exist, which is a very different grant from "these four".
#
# Install to /etc/sudoers.d/aatf-admin with mode 0440, and validate with
# `visudo -c -f` before activating.
#
# VERIFIED ON THE HOST (2026-07-29), not assumed:
#   - The bare form (`cmd action`) allows exactly that invocation and denies any
#     extra argument.
#   - A trailing `""` does NOT mean "one argument" -- it matches one literal
#     empty-string argument and denies everything else, including the
#     single-argument case. Do not use it here.
#   - The [0-9] glob below allows `hero-regen 2026-01-01` and denies
#     `2026-01-01; id`, `../../etc`, `notadate`, and `2026-01-01 evil`.
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger rebuild-web
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger git-sync
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger admin-redeploy

# hero-regen takes a date, so this one rule must accept an argument. The glob is
# as narrow as sudoers can express -- sudoers globs are fnmatch, not regex, so
# there is no repetition operator and the character classes are spelled out. The
# wrapper re-validates against ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ before the value
# reaches a unit name.
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger hero-regen [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]

# promote takes a preview job id, <kind>-YYYY-MM-DD. One rule per kind so the
# prefix stays a literal rather than a pattern; the wrapper and
# scripts/promote_preview.sh both re-validate the full shape.
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger promote hero-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]
aatfadmin ALL=(root) NOPASSWD: /usr/local/sbin/aatf-admin-trigger promote report-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]

# No grants for status or logs, deliberately. `systemctl show <unit>` works
# unprivileged (the panel's ActionRunner.status calls it without sudo), and
# journal reads come from membership in the systemd-journal group -- reading
# state is not a privileged action and must not be granted like one.
